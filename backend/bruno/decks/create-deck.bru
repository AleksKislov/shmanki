meta {
  name: Create Deck
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/decks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "title": "{{deckTitle}}",
    "description": "{{deckDescription}}",
    "languageCode": "{{preferredLanguage}}"
  }
}
