meta {
  name: Edit Generated Cards
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/generate/edit
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "deckId": "{{deckId}}",
    "generationId": "{{generationId}}",
    "prompt": "Split this into two info objects and make later cards focus on reconstruction"
  }
}
