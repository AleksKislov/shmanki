meta {
  name: Suggest Cards
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/generate/suggest
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "deckId": "{{deckId}}",
    "prompt": "linked list in typescript"
  }
}
