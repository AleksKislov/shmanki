meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "preferredLanguage": "{{preferredLanguage}}"
  }
}
